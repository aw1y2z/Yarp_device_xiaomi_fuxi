on early-fs
    # SELinux 保持 enforcing：recovery 域所需权限已在
    # system/sepolicy/private/recovery.te 的 TWRP_RECOVERY_POLICY 块补全。
    # vendor manifest 缺 version 字段，TWRP 拿不到 keymaster 版本；显式指定。
    # 设备带 android.hardware.keymaster@4.0.so，故为 4.x。
    setprop keymaster_ver 4.x
    # 部分 APEX 变体二进制 (如 hwservicemanager) 的 PT_INTERP 指向
    # /system/bin/bootstrap/linker64。ramdisk 里没有 APEX 解包目录，
    # 因此把标准 linker64 链接过去，否则 execv 会报 No such file or directory。
    mkdir /system/bin/bootstrap 0755 root root
    symlink /system/bin/linker64 /system/bin/bootstrap/linker64
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    # TWRP 把设置保存在 /mnt/vendor/persist/TWRP/.twrp_settings。
    # 这里必须挂真实 persist 分区，否则写到 tmpfs，重启即丢。
    wait /dev/block/bootdevice/by-name/persist
    # 注意：init 的 mount 第 5 个及之后的参数必须是空格分隔的独立 flag
    # （如 noatime nosuid nodev）；逗号串会被当作 ext4 的 mount data，
    # 其中 noatime 不是合法 data 项，mount() 会返回 EINVAL。
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/vendor/persist
    install_keyring

on init
    # 移植包的 update-binary 首行是 #!/sbin/sh，但 AOSP recovery
    # 的 ramdisk 里没有 /sbin（init.rc 中的 symlink 逻辑未生效），
    # 导致 execv 报 "No such file or directory"，TWRP 显示 error 255。
    # 这里显式补上链接，保证 /sbin/sh 可用。
    symlink /system/bin /sbin

on boot
    # boot HAL 由源码编译，与 ramdisk 的 libbase 版本一致，提供
    # IBootControl 供 SetActiveSlot() 做 slot 切换。
    start boot-hal-1-2
    setprop sys.usb.config adb
    # OTG：recovery 下 typec/UCSI 不会自动把 dwc3 切到 host，
    # 由守护脚本根据 VBUS/typec partner 自动切换角色。
    # exec_background 语法是 exec [SECLABEL [UID [GID]*] --] COMMAND ARGS...，
    # 缺少 -- 时整串会被当作命令名导致启动失败。
    exec_background u:r:recovery:s0 root root -- /system/bin/sh /system/bin/otg_watchdog.sh

on property:twrp.modules.loaded=true
    start vendor.keymaster-4-0
    # Mount firmware
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery
    start vendor.qseecomd
    # keymint AIDL V2 HAL. Its closed-source implementation
    # (vendor/lib64/libqtikeymint.so) is packaged into recovery/root/vendor,
    # so the source-built keystore2 can unwrap FBE keys through it.
    start vendor.keymint-qti
    start health-hal-2-1
    start vibratorfeature-hal-service
    umount /firmware

on property:vendor.sys.listeners.registered=true
    start gatekeeper-1-0
    start keystore2
