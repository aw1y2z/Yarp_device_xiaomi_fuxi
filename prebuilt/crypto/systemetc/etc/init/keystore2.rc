# Start the keystore2 service.
# Started explicitly by init.recovery.qcom.rc AFTER the keymint HAL is up,
# otherwise keystore2 gives up connecting to Keymint on first attempt.
service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    seclabel u:r:recovery:s0
