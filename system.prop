# ADB
ro.adb.secure=0
ro.boot.dynamic_partitions=true

# Battery Property
ro.charger.enable_suspend=1

# Gatekeeper
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# Reset allocatable space
# 必须与 BoardConfig.mk 的 BOARD_SUPER_PARTITION_SIZE 一致（fuxi = 9653190656）。
# sm8850 模板原值 13421772800 是跨平台取值，会导致动态分区容量计算错误。
ro.dynamic.full_size=9653190656

# USB
vendor.usb.configfs=1
vendor.usb.rps_mask=0
vendor.usb.uvc.function.init=1
